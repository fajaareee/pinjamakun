{
  "name": "@pinjamakun/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build && wxt build -b firefox",
    "zip": "wxt zip && wxt zip -b firefox",
    "lint": "wxt prepare && eslint .",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@pinjamakun/contracts": "workspace:*",
    "@pinjamakun/crypto": "workspace:*",
    "@phosphor-icons/react": "latest",
    "@wxt-dev/module-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "webextension-polyfill": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/webextension-polyfill": "latest",
    "typescript": "latest",
    "vitest": "latest",
    "wxt": "latest"
  }
}
